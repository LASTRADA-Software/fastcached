#pragma once

// Generated by CMake from cmake/Version.cmake. Do not edit by hand.
// The git tag is the single source of truth; see cmake/Version.cmake for the
// resolution order and for what each of the two values below may contain.

#include <string_view>

namespace FastCache
{

/// Numeric version triple, MAJOR.MINOR.PATCH with no suffix (e.g. "1.2.3"),
/// extracted at configure time. This is the value every packaging format sees.
inline constexpr std::string_view Version = "@FASTCACHED_VERSION@";

/// Full version string. Equal to Version for a build of a tagged commit;
/// otherwise it carries the git-describe distance and commit, plus a -dirty
/// marker for an unclean tree — e.g. "1.2.3-12-gdeadbee".
inline constexpr std::string_view VersionString = "@FASTCACHED_VERSION_STRING@";

/// Full server-version banner emitted by `version` (memcached text) and
/// `INFO` (Redis RESP).
inline constexpr std::string_view ServerVersionBanner = "fastcached-@FASTCACHED_VERSION_STRING@";

} // namespace FastCache

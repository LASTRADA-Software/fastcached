#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# Runtime component postinstall. Runs as root, from the macOS Installer.
#
# Every path out of this script exits 0. A non-zero postinstall aborts the whole
# installation and shows the user a dialog that names nothing actionable, so a
# failure to set up a convenience (a symlink, a default config) must never cost
# them the binaries that did install. Same discipline as Return="ignore" in
# packaging/windows/service-actions.xml.
set -u

PREFIX="/@FASTCACHED_MACOS_PREFIX@"
CONFIG="${PREFIX}/etc/fastcached.yaml"
DEFAULT_CONFIG="${PREFIX}/etc/fastcached.yaml.default"

# A .pkg has no equivalent of a dpkg conffile or an rpm %config(noreplace): the
# payload is written unconditionally on every install. So the live config is
# deliberately NOT in the payload — it is seeded from the shipped .default here,
# once, and an upgrade then leaves the operator's edits alone.
#
# The seed also gains the one setting that has to be live rather than commented
# out: storage_path. The shipped .default is the annotated reference shared with
# the Linux packages, where every key is commented and the example path is the
# FHS /var/lib one. The system LaunchDaemon passes only --config, precisely so
# that this file governs the cache location and the operator can move it — which
# means the location has to actually be set here, or the daemon comes up
# memory-only and loses the whole cache on every restart.
if [ ! -e "$CONFIG" ] && [ -e "$DEFAULT_CONFIG" ]; then
    if cp "$DEFAULT_CONFIG" "$CONFIG"; then
        cat >> "$CONFIG" <<EOF || true

# --- macOS package defaults -------------------------------------------------
# Set by the installer. Edit freely: this file survives upgrades, and the
# launchd job re-reads it on every start.
storage_path: ${PREFIX}/var/cache
EOF
    fi
fi

# State directory for the system LaunchDaemon. Created here rather than shipped
# as an empty payload directory so its ownership is set by the component that
# actually knows about the service account.
mkdir -p "${PREFIX}/var" "${PREFIX}/var/log" || true

# /etc/paths.d only takes effect for *login* shells, because path_helper runs
# from /etc/profile — an already-open terminal, a non-login `ssh host cmd`, and
# fish (which does not read /etc/profile) all miss it. /usr/local/bin is in the
# stock /etc/paths, so these symlinks make both tools reachable immediately, in
# every shell, without waiting for a new login.
mkdir -p /usr/local/bin || true
for tool in fastcached fastcache-cc; do
    ln -sfn "${PREFIX}/bin/${tool}" "/usr/local/bin/${tool}" || true
done

exit 0

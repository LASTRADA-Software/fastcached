#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# RPM %post — argument is the number of package versions that will remain
# installed: 1 on a fresh install, 2 or more during an upgrade.
set -e

SERVICE="@FASTCACHED_SERVICE_NAME@"

if [ -x /usr/bin/systemd-sysusers ]; then
    systemd-sysusers "@FASTCACHED_SYSUSERS_FILE@" >/dev/null 2>&1 || true
    systemd-sysusers "@FASTCACHED_NODE_SYSUSERS_FILE@" >/dev/null 2>&1 || true
fi
if [ -x /usr/bin/systemd-tmpfiles ]; then
    systemd-tmpfiles --create "@FASTCACHED_TMPFILES_FILE@" >/dev/null 2>&1 || true
fi


# **Restrict the machine-wide configs to their service accounts.**
#
# `install(FILES)` runs at PACKAGE-BUILD time when neither account exists, so it
# cannot chown -- which is why the payload ships `0644 root:root` and why this is
# the only place the mode can be set. Runs AFTER `systemd-sysusers` above for the
# same reason.
#
# These are the files the product's guidance tells operators to put `requirepass`
# into, and `Platform/FileTrust` already warns when a secret is read from a
# broadly-readable file -- the daemon complained about the file its own package
# shipped ([#861](https://github.com/LASTRADA-Software/fastcached/issues/861)).
#
# DIFFERENT groups: the two units run as `fastcached` and `fastcache-node`, and
# `fastcache-compile-node.sysusers` says sharing an account would let a compromised
# compile rewrite every cached object -- a shared group is that hole one notch
# weaker. Repaired only when the file is CURRENTLY WORLD-readable, so a group an
# operator chose is left alone -- and so this loop is idempotent, since the 0640 it
# writes is not world-readable and no later upgrade re-asserts it.
for _pair in "/@FASTCACHED_SYSCONF_DIR@/fastcached.yaml:fastcached" \
             "/@FASTCACHED_SYSCONF_DIR@/fastcache-compile-node.yaml:fastcache-node"; do
    _conf=${_pair%:*}
    _grp=${_pair##*:}
    [ -f "$_conf" ] || continue
    [ -n "$(find "$_conf" -maxdepth 0 -perm /0004 2>/dev/null)" ] || continue
    chgrp "$_grp" "$_conf" >/dev/null 2>&1 || continue
    chmod 0640 "$_conf" >/dev/null 2>&1 || true
done

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true

    if [ "$1" -eq 1 ]; then
        # Fresh install: enable for boot and start now.
        systemctl enable "${SERVICE}" >/dev/null 2>&1 || true
        systemctl start "${SERVICE}" >/dev/null 2>&1 || true
    else
        # Upgrade: respect the operator's enable choice, bounce only if running.
        systemctl try-restart "${SERVICE}" >/dev/null 2>&1 || true
    fi
fi

# A `compile-node.env` left over from before #291 is INERT now: the unit
# no longer reads it, so an operator who edits it gets silence. Silence is
# the failure this whole change is about, arriving from the other side, so
# say it once -- here, at the upgrade that stops reading it, on exactly the
# machines that have one. Whether rpm removes a %config(noreplace) file that a
# newer version stops shipping is #383's question and deliberately not answered
# here; this is the message, not the scrub, and it is correct either way -- if
# rpm did remove it, the test below simply does not fire.
if [ -f "/@FASTCACHED_SYSCONF_DIR@/compile-node.env" ]; then
    echo "fastcache-compile-node: /@FASTCACHED_SYSCONF_DIR@/compile-node.env is no longer read." >&2
    echo "  Its settings now live in /@FASTCACHED_SYSCONF_DIR@/fastcache-compile-node.yaml." >&2
    echo "  The old file is left in place; nothing reads it and it can be removed." >&2
fi

exit 0

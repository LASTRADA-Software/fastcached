#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# RPM %postun — $1 is 0 on the final erase, >=1 during an upgrade.
set -e

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

if [ "$1" -eq 0 ]; then
    # Final removal: cached data is expendable and can be large, so do not
    # leave it behind. The fastcached user is intentionally kept — other files
    # on the system may still be owned by it.
    rm -rf /var/lib/fastcached
fi

exit 0

# SPDX-License-Identifier: Apache-2.0
#
# The compile worker.
#
# Socket-activated: fastcache-compile-node.socket owns the port and this unit
# adopts it, so there is no --bind or --port here. Enable the SOCKET, not this:
#
#     systemctl enable --now fastcache-compile-node.socket
#
# Type=simple and NOT a daemonizing flag, for the reason the fastcached unit
# records: a double-fork silences journald and races Type=forking's pidfile.
#
# Override anything here with a drop-in rather than editing this file (it is
# replaced on upgrade):
#
#     systemctl edit fastcache-compile-node

[Unit]
Description=fastcache compile worker
Documentation=https://github.com/LASTRADA-Software/fastcached
Requires=fastcache-compile-node.socket
After=fastcache-compile-node.socket network-online.target
Wants=network-online.target

[Service]
Type=simple

# The scheduler address and the advertised endpoint are SITE-SPECIFIC and have no
# defensible default, so they come from a file an operator writes rather than
# from this unit. A worker nothing knows about serves nobody, so starting without
# them is a configuration error and the binary refuses -- loudly, at start, which
# is the right time to find out.
#
# That file is now the node's own YAML configuration rather than a shell fragment
# of command-line arguments (#291). One file, one grammar, one precedence rule:
# what an operator writes there is configuration the binary parses, not text a
# unit expands into an argument vector. The mechanism it replaces could disagree
# with the command line with nobody having written down which won.
#
# `--config` is passed explicitly, and it is NOT a second source of truth: the
# path below is the same one the node would discover on its own, because
# DefaultConfigPath's system candidate is `<sysconfdir>/{app}.yaml` and this
# application is `fastcache-compile-node`. Stating it is what makes the failure
# legible -- a config the operator NAMED is strict, so a missing or unparseable
# file stops the service here instead of silently starting a worker configured
# out of nothing. The two spellings cannot drift apart; one is the other written
# down.
#
# The TOOLCHAINS are not in it. "No default compiler" and "no discovery" turned
# out to be different claims: a default is how a job ends up running against
# something nobody chose, while which compilers a machine holds is a fact this
# worker can establish for itself. It surveys the machine at startup and serves
# what it finds; `toolchain:` narrows that, and `toolchain_discovery: false`
# turns it off.
ExecStart=/usr/bin/fastcache-compile-node --config=/etc/fastcached/fastcache-compile-node.yaml

# SIGTERM stops accepting and lets the accept loop finish; the stop flag is
# polled at 100 ms and jobs are served inline, so a clean stop is bounded by
# the compile in flight rather than by any drain of its own. TimeoutStopSec is
# generous for that reason: killing a worker mid-compile costs the client a
# local recompile, but it is not wrong -- waiting is simply cheaper.
KillSignal=SIGTERM
TimeoutStopSec=120

Restart=on-failure
RestartSec=1

User=fastcache-node
Group=fastcache-node

# A directory of this worker's OWN, and deliberately not `/`.
#
# systemd starts a service in `/` when it is given no WorkingDirectory, and on
# THIS unit that is not cosmetic. A dispatched compile is told the client's
# compilation directory and what to replace it with, and the worker spells that
# as `-fdebug-prefix-map=<directory>=<replacement>` for both its own directory
# and the client's -- because gcc records the client's and clang records this
# machine's, so mapping both gives one answer either way.
#
# A prefix-map rule appends the unmatched tail. So `<from>` = `/` matches EVERY
# absolute path in the object and keeps the rest of it: `/usr/include/stdio.h`
# becomes `.usr/include/stdio.h`. Measured on gcc 14.2.0 against a node running
# in `/`, `DW_AT_comp_dir` came back `.tmp/.../client` and every system header
# read `.usr/include/...`. The cache KEY is correct, so that object is stored and
# shared -- a wrong object under a right key, which is the failure this project
# is most careful about. Issue #674.
#
# `WorkerPrefixMapRules` in CompileJob.cpp drops the worker's own rule when this
# directory contains the client's, so a node installed from a package that
# predates this line does not produce that object. That guard is not a substitute
# for this line: it costs the clang half, leaving such a node's objects with this
# machine's absolute path in `DW_AT_comp_dir`. A WorkingDirectory is the only
# thing that buys that back.
#
# RuntimeDirectory= rather than a path the package installs: systemd creates it
# at start, owned by the account below, and removes it at stop -- so there is no
# directory to install, chown, migrate or clean up, and it is writable even under
# the ProtectSystem=strict further down. It is also somewhere no build tree ever
# lives, which matters because a worker directory that CONTAINED a client's build
# directory would drop the rule exactly as `/` does. That rules out the other
# obvious candidate, /tmp: continuous-integration builds run there.
#
# 0700 rather than the 0755 default. Nothing but this worker has any business in
# it, and UMask=0077 below says the same thing about what it writes.
RuntimeDirectory=fastcache-node
RuntimeDirectoryMode=0700
WorkingDirectory=/run/fastcache-node

# --- Hardening -------------------------------------------------------------
# This block is deliberately NOT a copy of fastcached's, and the difference is
# the whole point of the service: fastcached executes nothing, while this
# worker's entire job is to run a compiler. Every relaxation below is named
# with the reason, so a future tightening does not silently break compiles.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
CapabilityBoundingSet=

# Read-only /usr is what a compiler needs and all it needs: the toolchain is
# read, never written. Scratch goes to PrivateTmp above, which is this unit's
# own /tmp and is discarded when the service stops -- so a job that leaked a
# file cannot accumulate across restarts.
ProtectSystem=strict

# AF_UNIX and AF_NETLINK are not for listening. glibc's getaddrinfo needs both
# to resolve a non-numeric scheduler address (NSS reaches systemd-resolved over
# AF_UNIX and enumerates interfaces over AF_NETLINK), and `--scheduler
# build-cache.internal:6675` is the spelling an operator will reach for.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# @system-service covers fork and exec, which this unit cannot do without.
# Listed explicitly rather than inherited from a template, because a filter
# that forbade exec would make every job fail in a way that looks like a
# compiler bug rather than a policy decision.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# MemoryDenyWriteExecute is deliberately ABSENT, where fastcached sets it.
# Compilers legitimately map writable-then-executable memory -- LTO plugins and
# any JIT the driver loads -- so enabling it here would reject perfectly valid
# toolchains with an error pointing at the compiler instead of at this file.
# The restriction is worth having in a daemon that never execs and is simply
# not applicable to one whose purpose is to exec.

# No [Install]. The socket is what gets enabled; a service enabled on its own
# would start at boot and sit idle, which is the opposite of what activation is
# for.

# SPDX-License-Identifier: Apache-2.0
#
# Per-user fastcached unit, installed as `fastcached.service` under the systemd
# user directory:
#
#     systemctl --user enable --now fastcached
#
# Runs as the invoking user with no privileged setup at all — no service
# account, no /var/lib, no root. State lives under $XDG_STATE_HOME and the
# config under $XDG_CONFIG_HOME, so a personal compile cache needs nothing
# beyond the package itself.
#
# The config file is NOT shipped for user installs (a package cannot write into
# a home directory), so this unit starts on built-in defaults and works out of
# the box. To customise it, just put a file where fastcached already looks — no
# unit override needed:
#
#     mkdir -p ~/.config/fastcached
#     cp /etc/fastcached/fastcached.yaml ~/.config/fastcached/fastcached.yaml
#     systemctl --user restart fastcached
#
# ExecStart deliberately passes no --config, and must not start doing so.
# Naming a file the package does not ship made the very first
# `systemctl --user enable --now fastcached` fail with FileNotFound, and
# Restart=on-failure then respawned it once a second until the start limit
# tripped — an out-of-the-box restart loop instead of a working daemon.
# Leaving the flag off gets the file above when it exists, because the daemon's
# own lookup probes $XDG_CONFIG_HOME/fastcached/fastcached.yaml (then ~/.config)
# and simply skips what is absent. It will NOT pick up /etc/fastcached: that one
# describes the system daemon, and only a process running as root reads it — so
# an admin configuring the system service cannot accidentally point every user
# instance on the host at a cache directory it has no access to.

[Unit]
Description=fastcached — fast cache daemon (user instance)
Documentation=https://github.com/LASTRADA-Software/fastcached
After=network-online.target

[Service]
Type=simple

# %S is $XDG_STATE_HOME (~/.local/state); %E would be $XDG_CONFIG_HOME.
#
# A config at %E/fastcached/fastcached.yaml is picked up with no override at
# all. Use `systemctl --user edit fastcached` only for settings that have to be
# on the command line, or to name a config file somewhere else entirely:
#
#     [Service]
#     ExecStart=
#     ExecStart=/usr/bin/fastcached --config=%h/elsewhere/fastcached.yaml
ExecStart=/usr/bin/fastcached
ExecReload=/bin/kill -HUP $MAINPID

KillSignal=SIGTERM
TimeoutStopSec=30

Restart=on-failure
RestartSec=1

# Creates %S/fastcached (~/.local/state/fastcached) for storage_path.
StateDirectory=fastcached
StateDirectoryMode=0750

# --- Hardening -------------------------------------------------------------
# Deliberately a subset of the system unit's: directives needing privileged
# namespace setup (ProtectSystem=strict, ProtectHome, PrivateDevices,
# ProtectProc, ProtectKernel*) are unreliable or unavailable in a user manager
# and are left out rather than silently failing the unit.
NoNewPrivileges=yes
PrivateTmp=yes
# AF_UNIX/AF_NETLINK are needed by glibc's resolver, not for listening — see
# the system unit for the full rationale.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
